<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleBCI.Library\SimpleBCI.Library.csproj" />
  </ItemGroup>

  <Target Name="CopyLibraryOutput" AfterTargets="Build">

    <ItemGroup>
      <LibraryFiles Include="$(MSBuildProjectDirectory)\..\SimpleBCI.Library\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>

    <Copy SourceFiles="@(LibraryFiles)" DestinationFiles="@(LibraryFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

  </Target>

</Project>