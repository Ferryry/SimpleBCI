<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Model\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="brainflow" Version="5.22.2" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
  </ItemGroup>

  <Target Name="CopyBrainFlowNativeLibraries" AfterTargets="Build">
    <ItemGroup>
      <BrainFlowNativeLibraries Include="$(NuGetPackageRoot)brainflow\5.22.2\lib\*.dll" />
    </ItemGroup>
    
    <Copy 
      SourceFiles="@(BrainFlowNativeLibraries)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target> 

</Project>
